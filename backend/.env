DATABASE_URL=postgresql://postgres:signity2821@localhost:5432/studybuddy_ai

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-real-secret-before-running

# CORS — comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

# Ollama — defaults work for a standard local Ollama install
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# ChromaDB — leave blank to use ./chroma_data (relative to where uvicorn is run)
CHROMA_PERSIST_DIRECTORY=./chroma_data

# Uploads — leave blank to use <backend_root>/uploads
UPLOAD_DIRECTORY=
